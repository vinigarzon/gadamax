---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";
import { services, showcaseImages } from "../content/site.js";
---

<BaseLayout
  title="About us"
  description="Learn how Gadamax combines AI-native delivery, brand strategy, and cross-industry business expertise to launch digital solutions with speed and commercial clarity."
  currentPath="/about-us"
>
  <section class="page-hero section">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">About us</p>
        <h1>AI-native delivery. Human strategy.</h1>
        <p>
          Gadamax helps companies move from market insight to brand, product, and execution
          through a model that blends AI-accelerated build systems with real business judgment.
        </p>
      </div>
      <img
        src="/assets/images/page-header-about-services.jpg"
        alt="Abstract digital background for the Gadamax about page"
        width="1707"
        height="960"
        loading="eager"
      />
    </div>
  </section>

  <section class="section">
    <div class="container feature-split">
      <div>
        <SectionIntro
          eyebrow="How we think"
          title="We don't start with pages. We start with the business."
          description="Every engagement begins with context: market, audience, objectives, constraints, offer, content, and growth model. Then we shape the right digital response."
        />
        <div class="story-block">
          <p>
            Some clients need positioning, message architecture, and a faster path to launch.
            Others need a robust platform, e-commerce system, dashboard, loyalty engine, or
            automation layer. Gadamax is built to handle both the thinking and the execution.
          </p>
          <p>
            Our delivery model combines AI-native product workflows with strategic guidance from
            experienced operators, MBAs, and specialist voices across Latin America. That means
            faster output, lower overhead, and better business decisions behind the build.
          </p>
        </div>
      </div>

      <div class="feature-visual">
        <img
          src="/assets/images/about-driven-impact.jpg"
          alt="About Gadamax visual"
          width="800"
          height="627"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionIntro
        eyebrow="Core capabilities"
        title="Four pillars. One integrated growth system."
        description="Digital strategy, build, commerce, and automation are only useful when they stay connected to brand, buyers, budget, and operating reality."
      />
      <div class="service-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionIntro
        eyebrow="Showcase"
        title="Applied across multiple industries"
        description="The same core engine can adapt to hospitality, healthcare, community, loyalty, education, commerce, and product platforms."
        align="center"
      />
      <div class="showcase-strip">
        {showcaseImages.map((item) => (
          <figure>
            <img src={item.src} alt={item.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Looking for a team that can think commercially and build quickly?"
    body="Gadamax brings together strategy, brand, AI-accelerated execution, and cross-industry business perspective in one operating model."
    primaryHref="/contact"
    primaryLabel="Talk to Gadamax"
    secondaryHref="/portfolio"
    secondaryLabel="See our work"
  />
</BaseLayout>
