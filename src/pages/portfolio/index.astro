---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";
import CTASection from "../../components/CTASection.astro";
import { portfolioCategories, portfolioItems } from "../../content/site.js";
---

<BaseLayout
  title="Portfolio"
  description="Explore real Gadamax launches across hospitality, healthcare, loyalty, education, gaming, commerce, and custom digital platforms."
  currentPath="/portfolio"
>
  <section class="page-hero section">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1>Real launches across industries</h1>
        <p>
          From event venues and medical practices to loyalty engines, workforce platforms,
          translation commerce, gaming products, and education, this is proof that Gadamax can
          adapt its strategy and build model to very different business realities.
        </p>
      </div>
      <img
        src="/assets/images/page-header-portfolio.jpg"
        alt="Portfolio section background"
        width="1707"
        height="960"
        loading="eager"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionIntro
        eyebrow="Real work"
        title="Filter by industry or product context"
        description="These projects show the range of what Gadamax can shape and ship: websites, commerce experiences, member systems, workforce platforms, healthcare flows, dashboards, and loyalty products."
      />

      <div class="filter-bar" data-filter-bar>
        {portfolioCategories.map((category) => (
          <button
            class={category === "All" ? "is-active" : undefined}
            type="button"
            data-filter={category}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="portfolio-grid" data-filter-grid>
        {portfolioItems.map((item) => (
          <PortfolioCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Need this range, but tailored to your market?"
    body="Gadamax adapts strategy, brand, and execution to the realities of each business instead of forcing every client into the same template."
    primaryHref="/contact"
    primaryLabel="Discuss your project"
    secondaryHref="/services"
    secondaryLabel="View services"
  />
</BaseLayout>

<script>
  const bar = document.querySelector("[data-filter-bar]");
  const grid = document.querySelector("[data-filter-grid]");

  if (bar && grid) {
    const buttons = [...bar.querySelectorAll("button")];
    const cards = [...grid.querySelectorAll("[data-category]")];

    bar.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;

      const selected = target.dataset.filter;
      buttons.forEach((button) =>
        button.classList.toggle("is-active", button === target)
      );

      cards.forEach((card) => {
        const matches = selected === "All" || card.dataset.category === selected;
        card.toggleAttribute("hidden", !matches);
      });
    });
  }
</script>
