---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import CTASection from "../components/CTASection.astro";
import { siteMeta } from "../content/site.js";
---

<BaseLayout
  title="Contact us"
  description="Talk to Gadamax about strategy, branding, platforms, e-commerce, AI automation, dashboards, or any digital solution your business needs to launch or scale."
  currentPath="/contact"
>
  <section class="page-hero section">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Contact us</p>
        <h1>Let's scope the right move.</h1>
        <p>
          Tell us what you’re trying to launch, fix, automate, sell, validate, or scale. We work
          across industries and can help shape both the strategy and the execution.
        </p>
      </div>
      <img
        src="/assets/images/hero-automation-matrix.png"
        alt="Digital systems background"
        width="1800"
        height="500"
        loading="eager"
      />
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-copy">
        <div class="contact-cards">
          <article class="contact-card">
            <h2>Email</h2>
            <p>You can reach us directly any time.</p>
            <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
          </article>
          <article class="contact-card">
            <h2>Phone</h2>
            <p>Call the team in Mexico or the United States.</p>
            <a href={siteMeta.phoneMxHref}>{siteMeta.phoneMx}</a>
            <a href={siteMeta.phoneUsHref}>{siteMeta.phoneUs}</a>
          </article>
          <article class="contact-card">
            <h2>Locations</h2>
            <p>{siteMeta.addressMx}</p>
            <p>{siteMeta.addressUs}</p>
          </article>
        </div>
      </div>

      <ContactForm
        title="Tell us what you're building or trying to solve"
        subtitle="Include the industry, users, goals, timeline, and budget range if you have it. A website, platform, e-commerce flow, AI automation, loyalty system, dashboard, or full digital strategy are all on the table."
      />
    </div>
  </section>

  <CTASection
    title="Prefer to start with a focused brief?"
    body="Send the essentials and we’ll come back with a practical next step, not a generic pitch."
    primaryHref={`mailto:${siteMeta.email}`}
    primaryLabel="Email Gadamax"
    secondaryHref="/portfolio"
    secondaryLabel="Review portfolio"
  />
</BaseLayout>
