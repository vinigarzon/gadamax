---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import ContactForm from "../components/ContactForm.astro";
import CTASection from "../components/CTASection.astro";
import {
  services,
  portfolioItems,
  testimonials,
  ventureSignals,
  siteMeta
} from "../content/site.js";

const featuredProjects = portfolioItems.filter((item) => item.featuredOnHome).slice(0, 6);
const liveProjects = portfolioItems.filter((item) => item.website);
---

<BaseLayout
  title="AI-Native Strategy, Brand, and Software"
  description={siteMeta.description}
  currentPath="/"
>
  <Hero
    eyebrow="AI-native strategy • brand • build • scale"
    title="Strategy, brand, and software for businesses ready to move faster."
    description="Gadamax combines strategic consulting, brand thinking, AI-accelerated delivery, and cross-industry expert insight to launch websites, platforms, e-commerce, loyalty systems, automations, dashboards, and digital ventures with far less overhead than traditional agency models."
    primaryHref="/contact"
    primaryLabel="Start a project"
    secondaryHref="/portfolio"
    secondaryLabel="See real work"
    stats={[
      { value: "AI-native", label: "Execution with senior oversight" },
      { value: `${liveProjects.length}+`, label: "Live launches across industries" },
      { value: "U.S. + LATAM", label: "Strategy and expert network" }
    ]}
    image={{
      src: "/assets/images/hero-gadamax-home.png",
      alt: "Abstract digital horizon expressing scale, momentum, and venture growth"
    }}
  />

  <section class="section">
    <div class="container feature-split">
      <div>
        <SectionIntro
          eyebrow="About us"
          title="Not just development. A full digital growth engine."
          description="We help businesses define the market, sharpen the message, shape the brand, choose the right product path, and then execute the build with speed. Strategy, content, design, and software stay connected from day one."
        />
        <div class="signal-list">
          {ventureSignals.map((signal) => (
            <article class="signal-card">
              <h3>{signal.title}</h3>
              <p>{signal.body}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="feature-visual feature-visual--cards-align">
        <img
          src="/assets/images/about-driven-impact.jpg"
          alt="Gadamax team and workspace visual"
          width="800"
          height="627"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionIntro
        eyebrow="Services"
        title="Four entry points into a much broader delivery model"
        description="Some clients need a website. Others need a platform, loyalty engine, internal tool, automation layer, e-commerce operation, or sharper commercial strategy. We organize the work into four connected pillars so the solution fits the business."
      />
      <div class="service-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head-row">
      <SectionIntro
        eyebrow="Portfolio"
        title="Real launches across very different industries"
        description="From hospitality and healthcare to civic programs, loyalty ecosystems, education, translation commerce, and gaming, these projects show how Gadamax adapts the same strategic and execution model to very different operating realities."
      />
        <a class="button button-secondary" href="/portfolio">See all projects</a>
      </div>
      <div class="portfolio-grid">
        {featuredProjects.map((item) => (
          <PortfolioCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <SectionIntro
        eyebrow="Testimonials"
        title="Trusted by founders, operators, and growth teams"
        description="Clients come to Gadamax when they need more than code: they need clearer thinking, faster execution, and a partner who can connect strategy to delivery."
      />
      <div class="testimonial-grid">
        {testimonials.map((testimonial) => (
          <TestimonialCard testimonial={testimonial} />
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Need strategy, brand, software, or all of it working together?"
    body="Gadamax can help define the opportunity, shape the message, choose the right digital product, and build the system that supports growth."
    primaryHref="/contact"
    primaryLabel="Start the conversation"
    secondaryHref="/services"
    secondaryLabel="Explore services"
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-copy">
        <SectionIntro
          eyebrow="Contact us"
          title="Tell us what you need to solve"
          description="A website, platform, loyalty product, e-commerce flow, AI automation, dashboard, internal tool, or broader market strategy. Share the context, objectives, users, and budget, and we’ll help frame the right next move."
        />
        <div class="contact-cards">
          <article class="contact-card">
            <h3>Email</h3>
            <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
          </article>
          <article class="contact-card">
            <h3>Phone</h3>
            <a href={siteMeta.phoneMxHref}>{siteMeta.phoneMx}</a>
            <a href={siteMeta.phoneUsHref}>{siteMeta.phoneUs}</a>
          </article>
          <article class="contact-card">
            <h3>Locations</h3>
            <p>{siteMeta.addressMx}</p>
            <p>{siteMeta.addressUs}</p>
          </article>
        </div>
      </div>

      <ContactForm
        subtitle="Tell us about the industry, users, goals, timeline, and budget range if you have it. A website, platform, e-commerce flow, AI automation, loyalty system, dashboard, or full digital strategy are all on the table."
      />
    </div>
  </section>
</BaseLayout>
