---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import CTASection from "../components/CTASection.astro";
import { capabilityPillars, portfolioItems, services } from "../content/site.js";

const serviceProjects = portfolioItems.filter((item) => item.featuredOnHome).slice(0, 6);
---

<BaseLayout
  title="Services"
  description="Gadamax combines strategic consulting, AI-accelerated development, commerce systems, and automation to build digital solutions across industries."
  currentPath="/services"
>
  <section class="page-hero section">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Services</p>
        <h1>From business problem to digital solution.</h1>
        <ul class="hero-bullet-list">
          <li>Market strategy and buyer persona clarity</li>
          <li>Brand, content, and trust-building UX</li>
          <li>Websites, platforms, portals, and commerce</li>
          <li>AI automation, integrations, and reporting</li>
        </ul>
        <p>
          We can build almost any digital solution, but we don’t start by coding. We start by
          understanding the market, the customer, the goals, the operating model, and the budget
          so the right system gets built for the right reason.
        </p>
      </div>
      <img
        src="/assets/images/services-web-development.png"
        alt="Developer-focused illustration for Gadamax services"
        width="1536"
        height="1024"
        loading="eager"
      />
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionIntro
        eyebrow="Core services"
        title="Four pillars that support almost any digital engagement"
        description="Whether the outcome is a website, platform, loyalty program, dashboard, internal tool, e-commerce operation, or AI workflow, these are the capabilities that shape and ship the work."
      />
      <div class="service-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container feature-split">
      <div class="feature-visual feature-visual-square">
        <img
          src="/assets/images/hero-automation-matrix.png"
          alt="Automation matrix visualization"
          width="1800"
          height="500"
          loading="lazy"
        />
      </div>
      <div>
        <SectionIntro
          eyebrow="Execution pillars"
          title="What sits underneath the deliverables"
          description="Behind every launch is a mix of business analysis, offer design, content structure, product thinking, technical execution, and operational automation."
        />
        <div class="pillar-list">
          {capabilityPillars.map((pillar) => (
            <article class="pillar-card">
              <h3>{pillar.title}</h3>
              <p>{pillar.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionIntro
        eyebrow="Applied work"
        title="Proof across sectors and product types"
        description="These launches span very different industries, but they all come from the same principle: align strategy and execution so the digital product actually serves the business."
      />
      <div class="portfolio-grid">
        {serviceProjects.map((item) => (
          <PortfolioCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Need a digital solution, not just a vendor?"
    body="Bring the business problem, the opportunity, or even just the rough idea. Gadamax can help define the strategy and ship the right product path."
    primaryHref="/contact"
    primaryLabel="Request a consultation"
    secondaryHref="/portfolio"
    secondaryLabel="Browse case studies"
  />
</BaseLayout>
