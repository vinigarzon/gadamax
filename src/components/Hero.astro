---
const {
  eyebrow,
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  stats = [],
  image
} = Astro.props;
---

<section class="hero section">
  <div class="container">
    <div class="hero-panel">
      <div class="hero-panel__glow hero-panel__glow--one"></div>
      <div class="hero-panel__glow hero-panel__glow--two"></div>
      <div class="hero-grid">
        <div class="hero-copy">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{title}</h1>
          <p class="hero-description">{description}</p>

          <div class="hero-actions">
            {primaryHref && (
              <a class="button button-primary" href={primaryHref}>
                {primaryLabel}
              </a>
            )}
            {secondaryHref && (
              <a class="button button-secondary" href={secondaryHref}>
                {secondaryLabel}
              </a>
            )}
          </div>

          {stats.length > 0 && (
            <div class="hero-stats" aria-label="Highlights">
              {stats.map((stat) => (
                <article class="stat-chip">
                  <span>{stat.value}</span>
                  <p>{stat.label}</p>
                </article>
              ))}
            </div>
          )}
        </div>

        <div class="hero-visual">
          <div class="hero-orbit hero-orbit--outer" aria-hidden="true"></div>
          <div class="hero-orbit hero-orbit--inner" aria-hidden="true"></div>
          <div class="hero-pulse" aria-hidden="true"></div>
          {image && (
            <figure class="hero-image-stage">
              <img src={image.src} alt={image.alt ?? ""} loading="eager" />
            </figure>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
